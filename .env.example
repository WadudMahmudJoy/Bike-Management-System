# PostgreSQL Environment Configuration (Local Docker Development)
# IMPORTANT: Developers MUST set a secure local password below and update both connection URLs accordingly.
POSTGRES_USER="bike_admin"
POSTGRES_PASSWORD="SET_YOUR_LOCAL_DEVELOPMENT_PASSWORD"
POSTGRES_DB="bike_management_dev"
POSTGRES_SHADOW_DB="bike_management_shadow"
POSTGRES_PORT="5434"

# Prisma Database Connection Strings (Development & Shadow Database)
DATABASE_URL="postgresql://bike_admin:SET_YOUR_LOCAL_DEVELOPMENT_PASSWORD@127.0.0.1:5434/bike_management_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://bike_admin:SET_YOUR_LOCAL_DEVELOPMENT_PASSWORD@127.0.0.1:5434/bike_management_shadow?schema=public"

# Authentication Secrets & Proxy Configuration
AUTH_RATE_LIMIT_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
AUTH_TRUST_PROXY="false"
AUTH_TRUSTED_IP_HEADER="x-real-ip"

# Phase 3B1 Sensitive Data Encryption Keys (Base64-encoded 32-byte keys)
SENSITIVE_DATA_ACTIVE_KEY_VERSION="1"
SENSITIVE_DATA_ENCRYPTION_KEY_V1="GENERATE_A_BASE64_ENCODED_32_BYTE_KEY"
SENSITIVE_DATA_LOOKUP_HMAC_KEY="GENERATE_A_DIFFERENT_BASE64_ENCODED_32_BYTE_KEY"

# Site & SEO Configuration
SITE_URL="http://localhost:3000"
SITE_INDEXING_ENABLED="false"
