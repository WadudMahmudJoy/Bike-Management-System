{
  "name": "bike-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:admin-auth": "tsx -r ./scripts/register-server-only-mock.cjs scripts/test-admin-auth.ts",
    "test:admin-cli-smoke": "tsx scripts/test-admin-cli-smoke.ts",
    "test:customers": "tsx -r ./scripts/register-server-only-mock.cjs scripts/test-customer-management.ts",
    "test:sensitive-data": "tsx -r ./scripts/register-server-only-mock.cjs scripts/test-sensitive-data.ts",
    "admin:create": "tsx -r ./scripts/register-server-only-mock.cjs scripts/create-admin.ts",
    "db:test-integrity": "tsx scripts/test-database-integrity.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.41.1",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.1.2"
}
